# kmod 白名单：对齐 ZqinKing/wrt_release 太乙(re-cs-07) 的 kmods 归档
# 他归档 192 个，其中 124 个本固件已含（镜像 + 配置），剔除 6 个 WiFi 相关后剩 61 个（kmod-pppol2tp 见文末说明）。
# 全部 =m：只编成 ipk 供后续 opkg 安装，不进固件镜像。
# WiFi 相关（kmod-ath/ath11k/cfg80211/mac80211/nss-wifi-meshmgr）故意不加：
# 会重新拉整套 mac80211 backports 编译，且那是 ALL_KMODS 下 sdio 变体失败的位置。

# USB：网卡 / 串口 / 手机共享 / 4G 模块
CONFIG_PACKAGE_kmod-usb-acm=m
CONFIG_PACKAGE_kmod-usb-net=m
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=m
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=m
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=m
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=m
CONFIG_PACKAGE_kmod-usb-net-ipheth=m
CONFIG_PACKAGE_kmod-usb-net-rndis=m
CONFIG_PACKAGE_kmod-usb-net-rtl8152=m
CONFIG_PACKAGE_kmod-usb-net-sierrawireless=m
CONFIG_PACKAGE_kmod-usb-ohci=m
CONFIG_PACKAGE_kmod-usb-serial=m
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=m
CONFIG_PACKAGE_kmod-usb-serial-wwan=m
CONFIG_PACKAGE_kmod-usb-wdm=m

# Netfilter：iptables-legacy / 桥接过滤 / IPVS
CONFIG_PACKAGE_kmod-br-netfilter=m
CONFIG_PACKAGE_kmod-ipt-conntrack=m
CONFIG_PACKAGE_kmod-ipt-extra=m
CONFIG_PACKAGE_kmod-ipt-nat=m
CONFIG_PACKAGE_kmod-ipt-nat6=m
CONFIG_PACKAGE_kmod-ipt-physdev=m
CONFIG_PACKAGE_kmod-nf-ipvs=m
CONFIG_PACKAGE_kmod-nf-socket=m
CONFIG_PACKAGE_kmod-nfnetlink-queue=m
CONFIG_PACKAGE_kmod-nft-netdev=m
CONFIG_PACKAGE_kmod-nft-queue=m

# Crypto / lib：wireguard、ipsec、btrfs 的后端
CONFIG_PACKAGE_kmod-crypto-acompress=m
CONFIG_PACKAGE_kmod-crypto-blake2b=m
CONFIG_PACKAGE_kmod-crypto-ccm=m
CONFIG_PACKAGE_kmod-crypto-cmac=m
CONFIG_PACKAGE_kmod-crypto-ctr=m
CONFIG_PACKAGE_kmod-crypto-gcm=m
CONFIG_PACKAGE_kmod-crypto-geniv=m
CONFIG_PACKAGE_kmod-crypto-gf128=m
CONFIG_PACKAGE_kmod-crypto-ghash=m
CONFIG_PACKAGE_kmod-crypto-michael-mic=m
CONFIG_PACKAGE_kmod-crypto-seqiv=m
CONFIG_PACKAGE_kmod-crypto-sha256=m
CONFIG_PACKAGE_kmod-crypto-xxhash=m
CONFIG_PACKAGE_kmod-lib-lzo=m
CONFIG_PACKAGE_kmod-lib-raid6=m
CONFIG_PACKAGE_kmod-lib-xor=m
CONFIG_PACKAGE_kmod-lib-xxhash=m
CONFIG_PACKAGE_kmod-lib-zlib-deflate=m
CONFIG_PACKAGE_kmod-lib-zlib-inflate=m
CONFIG_PACKAGE_kmod-lib-zstd=m

# 文件系统
CONFIG_PACKAGE_kmod-fs-btrfs=m
CONFIG_PACKAGE_kmod-fs-msdos=m

# 5G 模组（MHI / QMI / QRTR）
CONFIG_PACKAGE_kmod-mhi-bus=m
CONFIG_PACKAGE_kmod-qcom-qmi-helpers=m
CONFIG_PACKAGE_kmod-qrtr=m
CONFIG_PACKAGE_kmod-qrtr-mhi=m
CONFIG_PACKAGE_kmod-qrtr-smd=m

# 其他：容器 / 内存压缩 / 内核 TLS
CONFIG_PACKAGE_kmod-dummy=m
CONFIG_PACKAGE_kmod-mii=m
CONFIG_PACKAGE_kmod-nls-cp932=m
CONFIG_PACKAGE_kmod-nls-cp950=m
CONFIG_PACKAGE_kmod-oaf=m
CONFIG_PACKAGE_kmod-tls=m
CONFIG_PACKAGE_kmod-veth=m
CONFIG_PACKAGE_kmod-zram=m
# kmod-pppol2tp 故意不加：qca-nss-ecm 把它当条件依赖，一旦开启（=m）镜像组装时 opkg 拉不到该模块，构建会失败
